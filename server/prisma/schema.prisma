// SpendSense Production Database Schema
// Database: PostgreSQL with Row-Level Security (RLS) support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                  @id @default(uuid())
  name                 String
  email                String                  @unique
  passwordHash         String
  isVerified           Boolean                 @default(false)
  currency             String                  @default("INR")
  monthlyIncomeTarget  Decimal                 @default(0.0) @db.Decimal(12, 2)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  transactions         Transaction[]
  budgets              Budget[]
  savingsGoals         SavingsGoal[]
  passwordResetTokens  PasswordResetToken[]
  notificationPref     NotificationPreference?

  @@index([email])
}

model Transaction {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    // "income" | "expense"
  amount        Decimal   @db.Decimal(12, 2)
  category      String
  description   String
  date          DateTime
  paymentMethod String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, category])
}

model Budget {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String
  amount         Decimal   @db.Decimal(12, 2)
  period         String    @default("monthly") // "monthly" | "weekly" | "yearly"
  startDate      DateTime  @default(now())
  alertThreshold Int       @default(75) // Percentage (e.g. 75)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, category, period])
  @@index([userId])
}

model SavingsGoal {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  targetAmount   Decimal   @db.Decimal(12, 2)
  currentAmount  Decimal   @default(0.0) @db.Decimal(12, 2)
  targetDate     DateTime
  category       String?
  description    String?
  status         String    @default("on_track") // "on_track" | "completed" | "at_risk"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetAlerts       Boolean  @default(true)
  overrunPredictions Boolean  @default(true)
  weeklyReport       Boolean  @default(true)
  goalMilestones     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

