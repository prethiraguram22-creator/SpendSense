# ==============================================================================
# SpendSense — Environment Variables Reference
# ==============================================================================
# COPY THIS FILE TO .env OR server/.env FOR LOCAL DEVELOPMENT
# NEVER COMMIT REAL SECRETS OR .env FILES TO GIT REPOSITORIES.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Render, Supabase, Neon, AWS RDS, or local PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://postgres:password123@localhost:5432/spendsense?schema=public

# Optional direct connection URL when using Prisma with a connection pooler (e.g. Supabase port 5432 vs 6543)
DIRECT_URL=postgresql://postgres:password123@localhost:5432/spendsense?schema=public

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Node.js / Express)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Cryptographically strong secret key used for signing session JWT tokens (min 32 characters)
# Generate a secure string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=spendsense_super_secure_jwt_signing_secret_key_32chars_min

# Session duration (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. CORS & CROSS-ORIGIN SECURITY
# ------------------------------------------------------------------------------
# Primary frontend application URL allowed to make credentialed requests
FRONTEND_URL=http://localhost:5173

# Comma-separated list of additional allowed origins (e.g. production Vercel domain)
# Example: https://spendsense.vercel.app,https://spendsense-preview.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------------------------
# 4. FRONTEND BUILD CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# Base URL for API requests.
# In local development: http://localhost:5000/api
# In production on Vercel: https://your-backend-service.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api
